{
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.14.0 || >=25.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/earcut": "^3.0.0",
    "@types/libtess": "^1.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/svg-path-parser": "^1.1.6",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@webgpu/types": "^0.1.72",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "esbuild": "^0.28.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "better-sqlite3"
    ]
  },
  "intent": {
    "skills": [
      "*"
    ]
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true
  },
  "name": "ecad",
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#/*": "./packages/core/src/*",
    "#web/*": "./packages/web/src/*"
  },
  "scripts": {
    "dev": "npm run dev --workspace @ecad/web --",
    "dev:web": "npm run dev --workspace @ecad/web --",
    "dev:desktop": "npm run dev --workspace @ecad/desktop --",
    "generate-routes": "npm run generate-routes --workspace @ecad/web",
    "build": "npm run build:web && npm run build:desktop && npm run build:cli",
    "build:web": "npm run build --workspace @ecad/web",
    "build:desktop": "npm run build --workspace @ecad/desktop",
    "build:cli": "npm run build --workspace @ecad/cli",
    "cli": "tsx packages/cli/src/main.ts",
    "preview": "npm run preview --workspace @ecad/web --",
    "start:desktop": "npm run start --workspace @ecad/desktop --",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "test": "tsx --test tests/*.test.ts packages/core/src/engine/*.test.ts && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "db:generate": "npm run db:generate --workspace @ecad/web",
    "db:migrate": "npm run db:migrate --workspace @ecad/web",
    "db:push": "npm run db:push --workspace @ecad/web",
    "db:pull": "npm run db:pull --workspace @ecad/web",
    "db:studio": "npm run db:studio --workspace @ecad/web",
    "perf": "tsx scripts/performance/run.ts",
    "perf:dev": "tsx scripts/performance/run.ts --development",
    "perf:baseline": "tsx scripts/performance/run.ts --baseline",
    "symbols:generate": "npm run generate --workspace @ecad/default-symbols --"
  }
}
