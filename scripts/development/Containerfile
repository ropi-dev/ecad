FROM docker.io/library/node:24.22.1-bookworm-slim@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c
ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN npm install --global pnpm@10.34.9 && pnpm dlx playwright@1.63.0 install --with-deps chromium && rm -rf /pnpm/store /root/.cache/pnpm && install -d -o node -g node /pnpm/store && apt-get update && apt-get install --no-install-recommends --yes util-linux && rm -rf /var/lib/apt/lists/*
COPY entrypoint.sh /opt/ecad/entrypoint.sh
WORKDIR /workspace
