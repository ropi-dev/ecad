    },
    {
      "kind": "text",
      "x": -195.014,
      "y": 45.884,
      "width": 37.1475,
      "height": 3.5559999999999996,
      "rotation": 0.0,
      "lineWidth": 0.18,
      "text": "If using RP2354 (internal flash), remove R10.\nR9 can be fit to use U3 as secondary memory.",
      "fontSize": 1.27,
      "horizontalAlign": "left",
      "verticalAlign": "bottom",
      "id": 615
    },
    {
      "kind": "text",
      "x": -148.024,
      "y": 40.29600000000001,
      "width": 8.254999999999999,
      "height": 3.5559999999999996,
      "rotation": 0.0,
      "lineWidth": 0.18,
      "text": "Flash",
      "fontSize": 2.54,
      "horizontalAlign": "left",
      "verticalAlign": "bottom",
      "id": 616
    },
    {
      "kind": "text",
      "x": -83.762,
      "y": -130.13799999999998,
      "width": 99.06,
      "height": 5.334,
      "rotation": 0.0,
      "lineWidth": 0.18,
      "text": "Note: S1 schematic revision indicates that this is the 1st revision of the schematic/BOM associated with the R4 PCB.\nR4-S1 therefore uniquely identifies the fully built PCB Assembly (PCBA).\nThis is a change from the previous revision numbering to align with the internal Raspberry Pi product revisioning scheme",
      "fontSize": 1.27,
      "horizontalAlign": "left",
      "verticalAlign": "middle",
      "id": 617
    },
    {
      "kind": "text",
      "x": 67.87599999999998,
      "y": 77.634,
      "width": 32.194500000000005,
      "height": 3.5559999999999996,
      "rotation": 0.0,
      "lineWidth": 0.18,
      "text": "Make sure R7 and R8 are close to RP2350\n",
      "fontSize": 1.27,
      "horizontalAlign": "left",
      "verticalAlign": "bottom",
      "id": 618
